# e2e only. The production proxy and loopback site (deploy/caddy/hostbud.caddy,
# imported unchanged), plus:
#   - the domain site for a test domain with a certificate from Caddy's own CA
#     (e2e has no Cloudflare token, public DNS or tailnet; the production site
#     differs only in its ACME DNS-01 issuer, checked by `make test`);
#   - a second loopback site for the tmux-less app ("tmux missing" scenario).
# Global options mirror the production Caddyfile.
{
	admin off
	skip_install_trust
	servers {
		protocols h1 h2
	}
}

import hostbud.caddy

hostbud.example.test {
	tls internal
	import hostbud
}

http://:9056 {
	reverse_proxy hostbud-e2e-app-notmux:8080
}
