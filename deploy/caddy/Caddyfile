# hostbud reverse proxy (docs/ARCHITECTURE.md §3).
{
	admin off
	servers {
		# Compose publishes TCP only, so don't advertise HTTP/3 (UDP).
		protocols h1 h2
	}
}

import hostbud.caddy

# The domain resolves to the host's Tailscale IP, and Compose publishes :443
# and :80 on that address only, so this site is reachable inside the tailnet
# only. Its certificate comes from Let's Encrypt via ACME DNS-01 (Cloudflare);
# the token is read from the environment at runtime. ACME_EMAIL is optional
# (an empty value drops the argument).
{$HOSTBUD_DOMAIN} {
	header Strict-Transport-Security "max-age=31536000"
	tls {$ACME_EMAIL} {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		# Find the zone through public resolvers: Docker's DNS (forwarding to
		# the host's, e.g. MagicDNS) may answer SERVFAIL to SOA queries.
		resolvers 1.1.1.1 1.0.0.1
		# Skip Caddy's own propagation check: through those resolvers it can
		# wait out a cached NXDOMAIN (the zone's negative TTL) and time out.
		# Cloudflare's nameservers serve the record within seconds, and Let's
		# Encrypt asks them directly.
		propagation_delay 20s
		propagation_timeout -1
	}
	reverse_proxy hostbud:8080 {
		header_up X-Hostbud-Via domain
	}
}
