# Copy to .env and fill in. .env is gitignored — never commit it.

# ── Domain & TLS ─────────────────────────────────────────────
# Subdomain with a Cloudflare A record (DNS only / grey cloud) pointing to TAILSCALE_IP
HOSTBUD_DOMAIN=hostbud.example.com
# Host's Tailscale IPv4 (100.x.y.z). Caddy binds only to this address.
TAILSCALE_IP=100.64.0.1
# Cloudflare API token with Zone:DNS:Edit on the domain's zone (for ACME DNS-01)
CLOUDFLARE_API_TOKEN=
# Email for ACME / Let's Encrypt account
ACME_EMAIL=

# ── Host user & SSH ──────────────────────────────────────────
# Run `id -u` / `id -g` on the host
HOST_UID=1000
HOST_GID=1000
# Absolute home dir of the host user
HOST_HOME=/home/dev
# User hostbud uses to SSH into the host machine itself
HOST_SSH_USER=dev
# Stable ssh-agent socket path on the host. With systemd's user ssh-agent.socket
# this is /run/user/<uid>/openssh_agent (check with `systemctl --user status ssh-agent.socket`).
HOST_SSH_AUTH_SOCK=/run/user/1000/openssh_agent
# Label for the host machine in the tree
HOSTBUD_HOST_LABEL=Host machine

# ── App ──────────────────────────────────────────────────────
# Loopback port for SSH port-forward access (plain HTTP on 127.0.0.1 only):
#   ssh -L 9055:localhost:9055 <host>  →  http://localhost:9055
HOSTBUD_LOCAL_PORT=9055
HOSTBUD_LISTEN=:8080
HOSTBUD_DATA_DIR=/data
HOSTBUD_POLL_INTERVAL=3s
HOSTBUD_LOG_LEVEL=info
# Optional: comma-separated Tailscale logins allowed (requires tailscaled socket mount)
HOSTBUD_ALLOWED_TS_USERS=
# Optional: path to tailscaled LocalAPI socket on the host
TAILSCALED_SOCKET=/var/run/tailscale/tailscaled.sock

# ── v2: orchestration (unused in v1) ─────────────────────────
# URL agents on target machines use to reach hostbud hooks (tailnet only)
HOSTBUD_URL=https://hostbud.example.com
HOSTBUD_LLM_PROVIDER=openai
HOSTBUD_LLM_MODEL=
OPENAI_API_KEY=
